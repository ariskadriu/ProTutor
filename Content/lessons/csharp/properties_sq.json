                "class Person",
                "private string name;"
            ]
        },
        {
            "Title": "Veti publike",
            "Difficulty": "Mesatar",
            "Exercise": "Shto një veti publike `Name`.",
            "RequiredKeywords": [
                "public string Name",
                "{",
                "}"
            ]
        },
        {
            "Title": "Aksesor get",
            "Difficulty": "Mesatar",
            "Exercise": "Shto `get` për të kthyer `name`.",
            "RequiredKeywords": [
                "get",
                "return name;"
            ]
        },
        {
            "Title": "Aksesor set",
            "Difficulty": "Mesatar",
            "Exercise": "Shto `set` për t'i dhënë vlerë `name = value;`.",
            "RequiredKeywords": [
                "set",
                "name = value;"
            ]
        },
        {
            "Title": "Auto-Veti",
            "Difficulty": "Mesatar",
            "Exercise": "Krijo auto-vetinë `public string Age { get; set; }`.",
            "RequiredKeywords": [
                "public string Age",
                "get;",
                "set;"
            ]
        }
    ]
