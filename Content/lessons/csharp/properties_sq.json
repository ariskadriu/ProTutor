{
    "Id": "cs_properties_sq",
    "Title": "Vetitë C# (Get/Set)",
    "Description": "Vetitë kombinojnë fushat dhe metodat për të mbrojtur të dhënat.",
    "Example": "Person p = new Person();\np.Name = \"Aris\";\nConsole.WriteLine(p.Name);",
    "Challenges": [
        {
