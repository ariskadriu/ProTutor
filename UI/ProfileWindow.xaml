<Window x:Class="ProgrammingTutor.UI.ProfileWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="User Profile &amp; Leaderboard" Height="500" Width="400"
        WindowStartupLocation="CenterOwner"
        Background="{StaticResource BackgroundBrush}"
        Foreground="{StaticResource TextBrush}"
        ResizeMode="NoResize">
    
    <Border Padding="20">
        <DockPanel>
            <TextBlock x:Name="ProfileHeader" Text="MY PROFILE" FontSize="20" FontWeight="Bold" Foreground="White" Margin="0,0,0,20" DockPanel.Dock="Top" HorizontalAlignment="Center"/>
            
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <TabControl Background="Transparent" BorderThickness="0">
                    <TabControl.Resources>
                        <Style TargetType="TabItem">
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="TabItem">
                                        <Border x:Name="border" BorderThickness="0,0,0,2" Margin="0,0,20,10" Padding="10,5">
                                            <ContentPresenter ContentSource="Header" RecognizesAccessKey="True" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsSelected" Value="True">
                                                <Setter TargetName="border" Property="BorderBrush" Value="{StaticResource AccentBrush}"/>
                                                <Setter Property="Foreground" Value="White"/>
                                            </Trigger>
                                            <Trigger Property="IsSelected" Value="False">
                                                <Setter Property="Foreground" Value="{StaticResource MutedTextBrush}"/>
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </TabControl.Resources>

                    <!-- Progress Tab -->
                    <TabItem Header="PROGRESS">
                        <StackPanel Margin="0,10,0,0">
                            <Border Background="{StaticResource SurfaceBrush}" Padding="15" CornerRadius="8" Margin="0,0,0,15">
                                <StackPanel>
                                    <TextBlock Text="Username" Foreground="{StaticResource MutedTextBrush}" FontSize="10"/>
                                    <TextBlock x:Name="UsernameText" Text="User" FontSize="18" FontWeight="Bold" Foreground="White"/>
                                </StackPanel>
                            </Border>

                            <TextBlock Text="COURSES" FontWeight="Bold" Margin="0,10,0,5"/>
                            <Border Background="{StaticResource SurfaceBrush}" Padding="15" CornerRadius="8" Margin="0,0,0,10">
                                <DockPanel>
                                    <TextBlock Text="Python" VerticalAlignment="Center"/>
                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                        <Button x:Name="PythonCertBtn" Content="🏆 CLAIM" Click="ClaimCert_Click" Tag="Python" Visibility="Collapsed" Style="{StaticResource ModernButton}" Background="#D4AF37" Foreground="Black" BorderThickness="0" Padding="10,2" Margin="0,0,10,0" FontSize="10" FontWeight="Bold"/>
                                        <TextBlock x:Name="PythonStats" Text="0/0" VerticalAlignment="Center" Foreground="{StaticResource AccentBrush}" FontWeight="Bold"/>
                                    </StackPanel>
                                </DockPanel>
                            </Border>
                            <Border Background="{StaticResource SurfaceBrush}" Padding="15" CornerRadius="8">
                                <DockPanel>
                                    <TextBlock Text="C# (.NET)" VerticalAlignment="Center"/>
                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                        <Button x:Name="CSharpCertBtn" Content="🏆 CLAIM" Click="ClaimCert_Click" Tag="C#" Visibility="Collapsed" Style="{StaticResource ModernButton}" Background="#D4AF37" Foreground="Black" BorderThickness="0" Padding="10,2" Margin="0,0,10,0" FontSize="10" FontWeight="Bold"/>
                                        <TextBlock x:Name="CSharpStats" Text="0/0" VerticalAlignment="Center" Foreground="#178600" FontWeight="Bold"/>
                                    </StackPanel>
                                </DockPanel>
                            </Border>

                            <Border Background="{StaticResource SurfaceBrush}" Padding="15" CornerRadius="8" Margin="0,0,0,15">
                                <StackPanel>
                                    <Button x:Name="TestCertBtn" Content="👁️ PREVIEW CERTIFICATE" Click="TestCert_Click" Style="{StaticResource ModernButton}" Background="#D4AF37" Foreground="Black" BorderThickness="0" Padding="10,5" FontSize="11" FontWeight="Bold"/>
                                </StackPanel>
                            </Border>

                            <TextBlock x:Name="AnalyticsHeader" Text="LEARNING ANALYTICS" FontWeight="Bold" Margin="0,15,0,5"/>
                            <Border Background="{StaticResource SurfaceBrush}" Padding="15" CornerRadius="8" Margin="0,0,0,20">
                                <StackPanel>
                                    <TextBlock x:Name="OverallCompletionLabel" Text="Overall Completion" Foreground="{StaticResource MutedTextBrush}" FontSize="12" Margin="0,0,0,10"/>
                                    <Grid Height="20" Margin="0,0,0,5">
                                        <Border Background="#0C0C0D" CornerRadius="10" BorderThickness="0">
                                            <Border x:Name="OverallProgressBar" HorizontalAlignment="Left" Background="{DynamicResource PremiumGradient}" CornerRadius="10" Width="0"/>
                                        </Border>
                                        <TextBlock x:Name="OverallProgressText" Text="0%" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="White" FontSize="10" FontWeight="Bold"/>
                                    </Grid>
                                    
                                    <Grid Margin="0,15,0,0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0">
                                            <TextBlock x:Name="ConqueredLabel" Text="Conquered Lessons" Foreground="{StaticResource MutedTextBrush}" FontSize="10"/>
                                            <TextBlock x:Name="LessonsConqueredText" Text="0" Foreground="White" FontSize="18" FontWeight="Bold"/>
                                        </StackPanel>
                                        <StackPanel Grid.Column="1">
                                            <TextBlock x:Name="ActiveTrackLabel" Text="Active Track" Foreground="{StaticResource MutedTextBrush}" FontSize="10"/>
                                            <TextBlock x:Name="ActiveTrackText" Text="Python" Foreground="White" FontSize="18" FontWeight="Bold"/>
                                        </StackPanel>
                                    </Grid>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </TabItem>

                    <!-- Leaderboard Tab -->
                    <TabItem Header="LEADERBOARD">
                        <ListBox x:Name="LeaderboardList" Background="Transparent" BorderThickness="0" Margin="0,10,0,0">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <Border Background="{StaticResource SurfaceBrush}" Margin="0,2" CornerRadius="8" Padding="10">
                                        <DockPanel>
                                            <TextBlock Text="{Binding Username}" FontWeight="Bold" Foreground="White"/>
                                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                                <TextBlock Text="{Binding Points}" Foreground="{StaticResource AccentBrush}" Margin="0,0,10,0"/>
                                                <TextBlock Text="{Binding Rank}" Foreground="{StaticResource MutedTextBrush}" FontSize="10" VerticalAlignment="Center"/>
                                            </StackPanel>
                                        </DockPanel>
                                    </Border>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </TabItem>
                </TabControl>
            </ScrollViewer>
        </DockPanel>
    </Border>
</Window>
